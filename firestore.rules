rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperuser() {
      return isAdmin() &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superuser';
    }

    // USERS collection
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // SUBMISSIONS collection
    match /submissions/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ADMINS collection
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // you must manually add admins from Firebase Console
    }

    // SETTINGS collection (e.g. registration open/closed flags)
    // read: any signed-in user (ActivityForm checks open/closed status)
    // write: superuser only (toggle control is superuser-only in the UI)
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperuser();
    }
  }
}
